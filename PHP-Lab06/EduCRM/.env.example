# =====================================================================
# EduCRM - Bien moi truong (TEMPLATE)
# COPY file nay thanh .env roi dien gia tri that:
#     Windows : copy .env.example .env
#     Linux   : cp .env.example .env
# File .env KHONG duoc commit (da nam trong .gitignore).
# Tren Docker/PaaS co the KHONG can .env: dat thang bien moi truong,
# chung se duoc uu tien hon file .env.
# =====================================================================

# --- Ung dung ---
# APP_ENV   : 'local' (may dev) | 'production' (server that)
# APP_DEBUG : true = hien loi chi tiet (CHI dung o local). Production LUON de false.
APP_ENV=production
APP_DEBUG=false

# Bat cac HTTP security header (nosniff / X-Frame-Options / CSP / HSTS...). Mac dinh: true
APP_SECURITY_HEADERS=true

# --- Ket noi MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=training_center_crm
# PRODUCTION: TUYET DOI khong dung 'root'. Tao user rieng quyen han che:
#   xem deploy/mysql-setup.sql
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
