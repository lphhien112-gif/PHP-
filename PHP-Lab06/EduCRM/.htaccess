# EduCRM - .htaccess GOC (CHI can khi KHONG the tro docroot vao public/)
# ---------------------------------------------------------------------
# Cach chuan van la: DocumentRoot = <du an>/public (bo qua file nay).
# Tren shared hosting docroot = thu muc goc du an thi file nay:
#   1) Chan tai ve file cau hinh / ma nguon nhay cam
#   2) Chuyen huong moi request vao public/

# --- 1. Chan cac duoi file nhay cam (phong ho) ---
<FilesMatch "\.(env|sql|log|md|lock|dist|json)$">
    Require all denied
</FilesMatch>

# --- 2. Route moi request vao public/ (tru khi da o trong public/) ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
